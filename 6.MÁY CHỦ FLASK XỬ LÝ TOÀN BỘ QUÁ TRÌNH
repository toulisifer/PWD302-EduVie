def send_smtp_email(to_email: str, student_name: str, subject_name: str, letter_body: str) -> tuple[bool, str]:
    load_dotenv(BASE_DIR / ".env", override=True)
    mail_username = os.environ.get("MAIL_USERNAME", "").strip()
    mail_password = os.environ.get("MAIL_PASSWORD", "").strip()

    if not mail_username or not mail_password:
        return (
            False,
            "Chưa cấu hình MAIL_USERNAME và MAIL_PASSWORD (Mật khẩu ứng dụng Gmail) trong file .env."
        )

    try:
        msg = MIMEMultipart()
        msg['From'] = f"Trung Tâm EduVie <{mail_username}>"
        msg['To'] = to_email
        msg['Subject'] = f"[EduVie] Thư giải đáp thắc mắc môn {subject_name} - Kính gửi bạn {student_name}"

        msg.attach(MIMEText(letter_body, 'plain', 'utf-8'))

        with smtplib.SMTP("smtp.gmail.com", 587, timeout=15) as server:
            server.ehlo()
            server.starttls()
            server.ehlo()
            server.login(mail_username, mail_password)
            server.sendmail(mail_username, [to_email], msg.as_string())

        return (True, f"Đã gửi thành công thư giải đáp đến hộp thư {to_email}")
    except Exception as err:
        return (False, f"Lỗi gửi email qua SMTP: {str(err)}")

@flask_app.route('/', methods=['GET', 'POST'])
def home():
    form = StudyQuestionForm()
    submitted_data = None

    if form.validate_on_submit():
        name = form.student_name.data.strip()
        subj = form.subject.data
        grd = form.grade.data
        q = form.question.data.strip()
        email = form.email.data.strip()

        """ 1. Tạo nội dung thư giải đáp bằng AI Gemini theo đúng mẫu của người dùng """
        ai_letter = generate_ai_email_content(name, subj, grd, q)

        """ 2. Gửi thư qua Email người nhận bằng SMTP Gmail (chạy ngầm đa luồng để phản hồi ngay lập tức) """
        email_thread = threading.Thread(
            target=send_smtp_email,
            args=(email, name, subj, ai_letter),
            daemon=True
        )
        email_thread.start()

        flash(f"Thành công! Lời giải môn {subj} đang được hệ thống gửi trực tiếp đến hộp thư {email} của bạn ({name}).", "success")

        submitted_data = {
            "name": name,
            "email": email,
            "subject": subj,
            "grade": grd,
            "question": q,
            "ai_letter": ai_letter,
            "email_status": {
                "success": True,
                "message": f"Thư giải đáp đang được chuyển phát đến hộp thư {email}"
            }
        }

    return render_template(
        'index.html',
        title="Trợ lí học tập EduVie",
        form=form,
        submitted_data=submitted_data
    )

@flask_app.route('/api/chat', methods=['POST'])
@csrf.exempt
def chat_endpoint():
    try:
        data = request.get_json(silent=True) or {}
        user_message = data.get("message", "").strip()
        history = data.get("history", [])
        grades_summary = data.get("grades_summary", "")

        if not user_message:
            return jsonify({"reply": "Vui lòng nhập câu hỏi của bạn."}), 400

        vn_tz = zoneinfo.ZoneInfo("Asia/Ho_Chi_Minh")
        current_time = datetime.now(vn_tz).strftime("%A, ngày %d/%m/%Y, %H:%M:%S")

        system_instruction = (
            f"Bạn là Trợ lý AI EduVie thông minh, chu đáo, ấm áp và truyền cảm hứng, chuyên hỗ trợ giải đáp học tập cho học sinh Việt Nam. "
            f"Thời gian hiện tại: {current_time}.\n"
            f"Dưới đây là thông tin bảng điểm của học sinh:\n"
            f"{grades_summary if grades_summary else 'Chưa có thông tin bảng điểm.'}\n\n"
            f"PHONG CÁCH VÀ NHIỆM VỤ:\n"
            f"- Trả lời thật sinh động, cuốn hút, kèm theo các ví dụ thực tế đời sống gần gũi để học sinh thấy kiến thức luôn thú vị và dễ hiểu.\n"
            f"- Luôn dùng giọng điệu thân thiện, tâm lý, đồng hành và khích lệ tinh thần học hỏi của học sinh.\n"
            f"- Giải thích cặn kẽ từng bước, không làm tắt, giúp học sinh nắm vững bản chất vấn đề.\n"
            f"- Nếu học sinh hỏi về kết quả điểm hay môn yếu, hãy chú ý môn có điểm thấp nhất để nhắc nhở khéo léo và đưa ra phương pháp ôn tập phù hợp, nhẹ nhàng.\n\n"
            f"QUY TẮC ĐỊNH DẠNG BẮT BUỘC:\n"
            f"- TUYỆT ĐỐI KHÔNG sử dụng dấu sao.\n"
            f"- TUYỆT ĐỐI KHÔNG sử dụng dấu thăng.\n"
            f"- Để làm nổi bật tiêu đề hoặc các ý chính, hãy dùng CHỮ IN HOA, dấu gạch ngang (-), số thứ tự (1, 2, 3) hoặc các emoji sinh động (📌, 🌟, 🔹, 📚, ✨, 💡).\n"
            f"- Trình bày mạch lạc, xuống dòng thoáng mắt, câu văn tự nhiên và dễ đọc."
        )

        contents = []
        for item in history:
            role = item.get("role", "user")
            content = item.get("content", "")
            contents.append(
                types.Content(
                    role=role,
                    parts=[types.Part.from_text(text=content)]
                )
            )
        contents.append(
            types.Content(
                role="user",
                parts=[types.Part.from_text(text=user_message)]
            )
        )

        candidate_models = [
            "gemini-3.5-flash",
            "gemini-3.5-flash-lite",
            "gemini-3.7-flash",
            "gemini-3.6-flash"
        ]

        last_err = None
        for model_name in candidate_models:
            try:
                response = client.models.generate_content(
                    model=model_name,
                    contents=contents,
                    config=types.GenerateContentConfig(
                        system_instruction=system_instruction
                    )
                )
                if response and response.text:
                    cleaned_reply = clean_markdown_formatting(response.text)
                    return jsonify({"reply": cleaned_reply})
            except Exception as model_err:
                last_err = model_err
                print(f"[Warning] Model {model_name} failed: {model_err}")
                continue

        err_msg = str(last_err) if last_err else "Không nhận được phản hồi từ AI."
        if "503" in err_msg or "UNAVAILABLE" in err_msg or "high demand" in err_msg:
            return jsonify({"reply": "Hệ thống AI hiện đang có lượng truy cập cao đột biến từ máy chủ. Bạn vui lòng gửi lại câu hỏi sau vài giây nhé!"})

        return jsonify({"detail": f"Lỗi AI: {err_msg}"}), 500

    except Exception as e:
        return jsonify({"detail": str(e)}), 500

@flask_app.route('/api/auth/register', methods=['POST'])
@csrf.exempt
def auth_register():
    try:
        data = request.get_json(silent=True) or {}
        username = data.get("username", "").strip()
        password = data.get("password", "").strip()
        confirm_password = data.get("confirm_password", "").strip()

        if not username:
            return jsonify({"success": False, "error": "Vui lòng nhập Tên đăng nhập."}), 400
        if len(username) < 2:
            return jsonify({"success": False, "error": "Tên đăng nhập cần có tối thiểu 2 ký tự."}), 400
        if not password:
            return jsonify({"success": False, "error": "Vui lòng nhập Mật khẩu."}), 400
        if len(password) < 4:
            return jsonify({"success": False, "error": "Mật khẩu cần có ít nhất 4 ký tự."}), 400
        if password != confirm_password:
            return jsonify({"success": False, "error": "Mật khẩu xác nhận không trùng khớp!"}), 400

        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("SELECT id FROM users WHERE username = ?", (username,))
        existing = cursor.fetchone()
        if existing:
            conn.close()
            return jsonify({"success": False, "error": "Tên tài khoản này đã tồn tại, vui lòng chọn tên khác."}), 400

        pwd_hash = generate_password_hash(password)
        vn_tz = zoneinfo.ZoneInfo("Asia/Ho_Chi_Minh")
        created_at = datetime.now(vn_tz).strftime("%d/%m/%Y %H:%M")

        cursor.execute(
            "INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)",
            (username, pwd_hash, created_at)
        )
        conn.commit()
        conn.close()

        return jsonify({
            "success": True,
            "message": "Tạo tài khoản thành công!",
            "username": username
        })
    except Exception as e:
        return jsonify({"success": False, "error": f"Lỗi hệ thống: {str(e)}"}), 500

@flask_app.route('/api/auth/login', methods=['POST'])
@csrf.exempt
def auth_login():
    try:
        data = request.get_json(silent=True) or {}
        username = data.get("username", "").strip()
        password = data.get("password", "").strip()

        if not username or not password:
            return jsonify({"success": False, "error": "Vui lòng nhập đầy đủ Tên và Mật khẩu."}), 400

        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("SELECT id, username, password_hash, created_at FROM users WHERE username = ?", (username,))
        row = cursor.fetchone()
        conn.close()

        if not row or not check_password_hash(row[2], password):
            return jsonify({"success": False, "error": "Tên tài khoản hoặc mật khẩu không chính xác."}), 401

        user_info = {
            "id": row[0],
            "username": row[1],
            "created_at": row[3]
        }
        session['user'] = user_info

        return jsonify({
            "success": True,
            "message": f"Đăng nhập thành công! Chào mừng {row[1]}",
            "user": user_info
        })
    except Exception as e:
        return jsonify({"success": False, "error": f"Lỗi hệ thống: {str(e)}"}), 500

@flask_app.route('/api/auth/logout', methods=['POST'])
@csrf.exempt
def auth_logout():
    session.pop('user', None)
    return jsonify({"success": True, "message": "Đã đăng xuất thành công."})

@flask_app.route('/api/auth/me', methods=['GET'])
def auth_me():
    user = session.get('user')
    if user:
        return jsonify({"logged_in": True, "user": user})
    return jsonify({"logged_in": False})

