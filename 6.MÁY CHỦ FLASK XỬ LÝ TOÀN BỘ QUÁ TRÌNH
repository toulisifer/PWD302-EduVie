def clean_markdown_formatting(text: str) -> str:
    if not text:
        return ""
    """ Giu nguyen phep nhan toan hoc 2 x 3 """
    cleaned = re.sub(r'(\d)\s{0,}[\x2a]\s{0,}(\d)', r'\1 × \2', text)
    """ Chuyen gach dau dong dang sao sang gach ngang """
    cleaned = re.sub(r'(?m)^(\s{0,})[\x2a]\s+', r'\1- ', cleaned)
    """ Bo dau thang tieu de o dau dong """
    cleaned = re.sub(r'(?m)^[\x23]{1,6}\s*', '', cleaned)
    """ Loai bo hoan toan dau sao va dau thang """
    cleaned = cleaned.replace('\x2a\x2a', '').replace('\x2a', '').replace('\x23', '')
    return cleaned.strip()

